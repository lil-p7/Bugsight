# --- Phase 1: AI review engine ---
# Required. Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional. Model used for reviews. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- Phase 2: GitHub integration (not required yet) ---
# GitHub App credentials (created in Phase 2)
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY_PATH=./private-key.pem
# GITHUB_WEBHOOK_SECRET=

# --- Safety limits (used from Phase 3) ---
# Max characters of diff sent to the model per review
# MAX_REVIEW_CHARS=60000
# Max files considered per pull request
# MAX_FILES_PER_REVIEW=30